raw <- readxl::read_excel(
  file_path,
  sheet = sheet_name,
  col_names = FALSE,
  .name_repair = "unique"
)

names(raw) <- paste0("col_", seq_along(names(raw)))

raw <- raw %>%
  dplyr::mutate(dplyr::across(dplyr::everything(), clean_chr))

cat("\nRaw Excel loaded.\n")
cat("Rows:", nrow(raw), "\n")
cat("Columns:", ncol(raw), "\n")

# ============================================================
# parse excel block!!!!!!!!! If you listened to the above 
#       I didn't have to do this!!!!!!!!!!!! 
# ============================================================

raw_mat <- as.data.frame(raw, stringsAsFactors = FALSE, check.names = FALSE)

is_header_row <- apply(raw_mat, 1, function(r) {
  r <- clean_chr(r)
  
  any(stringr::str_to_lower(r) == "sub_id", na.rm = TRUE) &&
    any(stringr::str_detect(stringr::str_to_lower(r), "ill\\d+"), na.rm = TRUE)
})

header_rows <- which(is_header_row)

if (length(header_rows) == 0) {
  stop("No header rows found. Could not find rows containing sub_id and ill-number SOA columns.")
}

cat("\nHeader rows found:", paste(header_rows, collapse = ", "), "\n")

all_long <- list()
block_info <- list()

for (h in seq_along(header_rows)) {
  
  header_i <- header_rows[h]
  next_header <- ifelse(h < length(header_rows), header_rows[h + 1], nrow(raw_mat) + 1)
  
  header <- clean_chr(unlist(raw_mat[header_i, ]))
  header_low <- stringr::str_to_lower(header)
  header_text <- paste(header, collapse = " ")
  
  viewing_from_header <- standardise_viewing(header_text)
  
  sub_col <- which(header_low == "sub_id")[1]
  if (is.na(sub_col)) next
  
  id_col <- sub_col + 1
  age_col <- sub_col + 2
  sex_col <- sub_col + 3
  
  condition_col <- sub_col - 1
  if (condition_col < 1) condition_col <- NA_integer_
  
  # SOA headers mark the proportion columns.
  # the blank column immediately after each SOA header is the corresponding 
  # RT column.
  soa_cols <- which(stringr::str_detect(header, "^-?\\d+\\s*ill\\d+"))
  
  if (length(soa_cols) == 0) {
    cat("\nNo SOA columns found for header row", header_i, "\n")
    next
  }
  
  soa_map <- tibble::tibble(
    prop_col = soa_cols,
    rt_col = soa_cols + 1,
    SOA = extract_soa(header[soa_cols]),
    soa_header = header[soa_cols]
  ) %>%
    dplyr::filter(is.finite(SOA), rt_col <= ncol(raw_mat)) %>%
    dplyr::arrange(SOA)
  
  # Spreadsheet-provided summary columns, if present.
  # These are only audit columns. They are not used for the analysis.
  provided_tbw_av_col <- which(stringr::str_detect(header_low, "^tbw\\s*av"))[1]
  provided_tbw_va_col <- which(stringr::str_detect(header_low, "^tbw\\s*va"))[1]
  provided_av_rt_col  <- which(stringr::str_detect(header_low, "^av\\s*(bi\\s*)?rt$|^av\\s*rt$"))[1]
  provided_va_rt_col  <- which(stringr::str_detect(header_low, "^va\\s*(bi\\s*)?rt$|^va\\s*rt$"))[1]
  
  cat("\nBlock", h, "| header row:", header_i, "\n")
  cat("Viewing from header:", viewing_from_header, "\n")
  cat("Subject column:", sub_col, "\n")
  cat("ID column:", id_col, "\n")
  cat("Condition column:", condition_col, "\n")
  cat("SOAs:", paste(soa_map$SOA, collapse = ", "), "\n")
  cat("Provided TBW AV col:", provided_tbw_av_col, "\n")
  cat("Provided TBW VA col:", provided_tbw_va_col, "\n")
  cat("Provided AV RT col:", provided_av_rt_col, "\n")
  cat("Provided VA RT col:", provided_va_rt_col, "\n")
  
  current_condition <- NA_character_
  current_viewing <- viewing_from_header
  
  block_rows <- list()
  
  for (r_i in seq(header_i + 1, next_header - 1)) {
    
    row <- clean_chr(unlist(raw_mat[r_i, ]))
    subj <- row[sub_col]
    
    if (is.na(subj)) next
    if (!stringr::str_detect(stringr::str_to_lower(subj), "^sub[-_]")) next
    if (stringr::str_to_lower(subj) %in% c("mean", "sd", "se")) next
    
    participant_id <- if (id_col <= length(row)) row[id_col] else NA_character_
    age <- if (age_col <= length(row)) to_num(row[age_col]) else NA_real_
    sex <- if (sex_col <= length(row)) row[sex_col] else NA_character_
    
    condition_raw <- NA_character_
    if (!is.na(condition_col)) condition_raw <- row[condition_col]
    
    detected_viewing <- standardise_viewing(condition_raw)
    detected_condition <- standardise_condition(condition_raw)
    
    if (!is.na(detected_viewing)) current_viewing <- detected_viewing
    if (!is.na(detected_condition)) current_condition <- detected_condition
    if (is.na(current_viewing)) current_viewing <- viewing_from_header
    
    provided_tbw_av <- if (!is.na(provided_tbw_av_col)) to_num(row[provided_tbw_av_col]) else NA_real_
    provided_tbw_va <- if (!is.na(provided_tbw_va_col)) to_num(row[provided_tbw_va_col]) else NA_real_
    provided_av_rt  <- if (!is.na(provided_av_rt_col))  to_num(row[provided_av_rt_col])  else NA_real_
    provided_va_rt  <- if (!is.na(provided_va_rt_col))  to_num(row[provided_va_rt_col])  else NA_real_
    
    tmp <- soa_map %>%
      dplyr::mutate(
        row_index = r_i,
        block = h,
        sub_id = subj,
        participant_id = participant_id,
        age = age,
        sex = sex,
        raw_condition_text = condition_raw,
        condition = current_condition,
        viewing = current_viewing,
        prop = purrr::map_dbl(prop_col, ~ to_num(row[.x])),
        rt = purrr::map_dbl(rt_col, ~ to_num(row[.x])),
        provided_tbw_AV = provided_tbw_av,
        provided_tbw_VA = provided_tbw_va,
        provided_rt_AV = provided_av_rt,
        provided_rt_VA = provided_va_rt
      ) %>%
      dplyr::select(
        block,
        row_index,
        sub_id,
        participant_id,
        age,
        sex,
        viewing,
        condition,
        raw_condition_text,
        SOA,
        prop,
        rt,
        provided_tbw_AV,
        provided_tbw_VA,
        provided_rt_AV,
        provided_rt_VA
      )
    
    block_rows[[length(block_rows) + 1]] <- tmp
  }
  
  if (length(block_rows) > 0) {
    all_long[[length(all_long) + 1]] <- dplyr::bind_rows(block_rows)
  }
  
  block_info[[length(block_info) + 1]] <- tibble::tibble(
    block = h,
    header_row = header_i,
    viewing_from_header = viewing_from_header,
    sub_col = sub_col,
    id_col = id_col,
    condition_col = condition_col,
    n_soa = nrow(soa_map),
    min_soa = min(soa_map$SOA, na.rm = TRUE),
    max_soa = max(soa_map$SOA, na.rm = TRUE)
  )
}

long_all <- dplyr::bind_rows(all_long)

if (nrow(long_all) == 0) {
  stop("No subject-level data were parsed. Check Excel layout.")
}

long_all <- long_all %>%
  dplyr::mutate(
    sub_id = stringr::str_replace_all(sub_id, "_", "-"),
    participant_id = ifelse(is.na(participant_id), "", participant_id),
    side = dplyr::case_when(
      SOA < 0 ~ "AV",
      SOA > 0 ~ "VA",
      SOA == 0 ~ "Sync",
      TRUE ~ NA_character_
    )
  )

# Manual exclusions happen here.
if (length(exclude_sub_ids) > 0) {
  long_all <- long_all %>%
    dplyr::filter(!sub_id %in% exclude_sub_ids)
  cat("\nExcluded sub_id values:", paste(exclude_sub_ids, collapse = ", "), "\n")
}

if (length(exclude_participant_ids) > 0) {
  long_all <- long_all %>%
    dplyr::filter(!participant_id %in% exclude_participant_ids)
  cat("\nExcluded participant_id values:", paste(exclude_participant_ids, collapse = ", "), "\n")
}

cat("\nParsed long data:\n")
print(long_all %>% dplyr::count(viewing, condition, side))

cat("\nSubjects parsed:\n")
print(
  long_all %>%
    dplyr::distinct(viewing, condition, sub_id, participant_id) %>%
    dplyr::arrange(viewing, condition, sub_id),
  n = Inf
)

cat("\nBlock info:\n")
print(dplyr::bind_rows(block_info))

if (save_csv_outputs) {
  readr::write_csv(long_all, file.path(out_root, "parsed_long_all.csv"))
  readr::write_csv(dplyr::bind_rows(block_info), file.path(out_root, "block_info.csv"))
}

