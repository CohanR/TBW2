      dplyr::filter(subject_key == one_subject_key)
    
    curves_gauss <- subject_gauss_grid %>%
      dplyr::filter(subject_key == one_subject_key)
    
    labels <- subject_summary %>%
      dplyr::filter(subject_key == one_subject_key) %>%
      dplyr::left_join(
        subject_gauss %>%
          dplyr::select(subject_key, group, gauss_fwhm, gauss_fit_flag),
        by = c("subject_key", "group")
      ) %>%
      dplyr::mutate(
        x_label = min(obs$SOA, na.rm = TRUE),
        y_label = 1.12,
        label = paste0(
          "sub_id: ", sub_id,
          "\nID: ", participant_id,
          "\nAV TBW: ", round(tbw_raw_AV, 1), " ms [", fit_flag_AV, "]",
          "\nVA TBW: ", round(tbw_raw_VA, 1), " ms [", fit_flag_VA, "]",
          "\nFull raw TBW: ", round(full_tbw_raw, 1), " ms",
          "\nGaussian FWHM QC: ", round(gauss_fwhm, 1), " ms [", gauss_fit_flag, "]"
        )
      )
    
    ggplot2::ggplot(obs, ggplot2::aes(x = SOA, y = prop)) +
      ggplot2::geom_point(size = 2.2, alpha = 0.90, colour = "black") +
      ggplot2::geom_line(
        data = curves_sig,
        ggplot2::aes(x = SOA, y = sig_fit, group = interaction(group, side)),
        linewidth = 1.1,
        colour = "blue",
        na.rm = TRUE
      ) +
      ggplot2::geom_line(
        data = curves_gauss,
        ggplot2::aes(x = SOA, y = gauss_fit, group = group),
        linewidth = 1.1,
        colour = "red",
        alpha = 0.90,
        na.rm = TRUE
      ) +
      ggplot2::geom_vline(xintercept = 0, linewidth = 0.5, colour = "grey30") +
      ggplot2::geom_vline(
        data = labels,
        ggplot2::aes(xintercept = x0_AV),
        linetype = "dashed",
        linewidth = 0.6,
        colour = "blue",
        alpha = 0.70,
        na.rm = TRUE
      ) +
      ggplot2::geom_vline(
        data = labels,
        ggplot2::aes(xintercept = x0_VA),
        linetype = "dashed",
        linewidth = 0.6,
        colour = "blue",
        alpha = 0.70,
        na.rm = TRUE
      ) +
      ggplot2::geom_text(
        data = labels,
        ggplot2::aes(x = x_label, y = y_label, label = label),
        inherit.aes = FALSE,
        hjust = 0,
        vjust = 1,
        size = 3.0,
        lineheight = 1.02
      ) +
      ggplot2::facet_wrap(~ group_label, ncol = 1) +
      ggplot2::scale_x_continuous(
        breaks = c(-300, -250, -200, -150, -100, -50, 0, 50, 100, 150, 200, 250, 300),
        limits = c(-320, 320)
      ) +
      ggplot2::scale_y_continuous(
        limits = c(0, 1.18),
        breaks = seq(0, 1, 0.25)
      ) +
      ggplot2::labs(
        title = paste0("Individual QC: ", one_subject_key),
        subtitle = "Blue = separate AV/VA sigmoid fits; red = full Gaussian QC overlay",
        x = "SOA (ms)",
        y = "Proportion perceived simultaneous"
