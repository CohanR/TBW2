  paired_ip_ol_test <- function(df, value_col, label) {
    
    value_col <- rlang::enquo(value_col)
    
    wide <- df %>%
      dplyr::filter(group %in% c("IP", "OL")) %>%
      dplyr::select(sub_id, group, value = !!value_col) %>%
      tidyr::pivot_wider(names_from = group, values_from = value) %>%
      dplyr::filter(is.finite(IP), is.finite(OL))
    
    cat("\n\n============================================================\n")
    cat(label, "\n")
    cat("Paired n:", nrow(wide), "\n")
    cat("Raw finite values retained. Check flags separately.\n")
    cat("============================================================\n")
    
    if (nrow(wide) < 2) {
      cat("Not enough paired data.\n")
      return(NULL)
    }
    
    diff_vals <- wide$IP - wide$OL
    
    desc <- tibble::tibble(
      n = nrow(wide),
      mean_IP = mean(wide$IP),
      sd_IP = sd(wide$IP),
      mean_OL = mean(wide$OL),
      sd_OL = sd(wide$OL),
      mean_difference_IP_minus_OL = mean(diff_vals),
      sd_difference = sd(diff_vals)
    )
    
    print(desc)
    
    sh_tbl <- NULL
    
    if (nrow(wide) >= 3) {
      sh <- shapiro.test(diff_vals)
      
      sh_tbl <- tibble::tibble(
        W = unname(sh$statistic),
        p_value = unname(sh$p.value)
      )
      
      cat("\nShapiro-Wilk on paired differences:\n")
      print(sh_tbl)
    }
    
    t_res <- t.test(wide$IP, wide$OL, paired = TRUE)
    
    t_tbl <- tibble::tibble(
      test = "paired t-test",
      t = unname(t_res$statistic),
      df = unname(t_res$parameter),
      p_value = unname(t_res$p.value),
      conf_low = t_res$conf.int[1],
      conf_high = t_res$conf.int[2]
    )
    
    cat("\nPaired t-test:\n")
    print(t_tbl)
    
    w_res <- wilcox.test(
      wide$IP,
      wide$OL,
      paired = TRUE,
      exact = FALSE,
      correct = TRUE
    )
    
    w_tbl <- tibble::tibble(
      test = "Wilcoxon signed-rank",
      W = unname(w_res$statistic),
      p_value = unname(w_res$p.value)
    )
    
    cat("\nWilcoxon signed-rank:\n")
    print(w_tbl)
    
    d_tbl <- effectsize::cohens_d(
      wide$IP,
      wide$OL,
      paired = TRUE,
      hedges_correction = TRUE,
      ci = 0.95
    )
    
    cat("\nPaired-samples Cohen's d:\n")
    print(d_tbl)
    
    tibble::tibble(
      label = label,
      paired_n = nrow(wide),
      mean_IP = desc$mean_IP,
      sd_IP = desc$sd_IP,
      mean_OL = desc$mean_OL,
      sd_OL = desc$sd_OL,
      mean_difference_IP_minus_OL = desc$mean_difference_IP_minus_OL,
      shapiro_W = ifelse(is.null(sh_tbl), NA_real_, sh_tbl$W),
      shapiro_p = ifelse(is.null(sh_tbl), NA_real_, sh_tbl$p_value),
      t = t_tbl$t,
      df = t_tbl$df,
      t_p = t_tbl$p_value,
      t_conf_low = t_tbl$conf_low,
      t_conf_high = t_tbl$conf_high,
      wilcox_W = w_tbl$W,
      wilcox_p = w_tbl$p_value
    )
  }
  
  independent_group_test <- function(df, value_col, label) {
    
    value_col <- rlang::enquo(value_col)
    
    d <- df %>%
      dplyr::filter(group %in% c("BI", "MO")) %>%
      dplyr::select(subject_key, group, value = !!value_col) %>%
      dplyr::filter(is.finite(value))
    
    cat("\n\n============================================================\n")
    cat(label, "\n")
    cat("Group counts:\n")
    print(table(d$group))
    cat("Raw finite values retained. Check flags separately.\n")
    cat("============================================================\n")
    
    if (length(unique(d$group)) < 2) {
      cat("Not enough groups.\n")
      return(NULL)
    }
    
    desc <- d %>%
      dplyr::group_by(group) %>%
      dplyr::summarise(
        n = dplyr::n(),
        mean = mean(value),
        sd = sd(value),
        se = sd / sqrt(n),
        .groups = "drop"
      )
    
    print(desc)
    
    t_res <- t.test(value ~ group, data = d, var.equal = FALSE)
    
    t_tbl <- tibble::tibble(
      test = "Welch independent t-test",
      t = unname(t_res$statistic),
      df = unname(t_res$parameter),
      p_value = unname(t_res$p.value),
      conf_low = t_res$conf.int[1],
      conf_high = t_res$conf.int[2]
    )
    
    cat("\nWelch independent t-test:\n")
    print(t_tbl)
    
    w_res <- wilcox.test(value ~ group, data = d, exact = FALSE, correct = TRUE)
    
    w_tbl <- tibble::tibble(
      test = "Wilcoxon rank-sum",
      W = unname(w_res$statistic),
      p_value = unname(w_res$p.value)
    )
    
    cat("\nWilcoxon rank-sum:\n")
    print(w_tbl)
    
    d_eff <- effectsize::cohens_d(
      value ~ group,
      data = d,
      pooled_sd = FALSE,
      ci = 0.95
    )
    
    cat("\nCohen's d:\n")
    print(d_eff)
    
    tibble::tibble(
      label = label,
      n_BI = desc$n[desc$group == "BI"],
      mean_BI = desc$mean[desc$group == "BI"],
      sd_BI = desc$sd[desc$group == "BI"],
      n_MO = desc$n[desc$group == "MO"],
      mean_MO = desc$mean[desc$group == "MO"],
      sd_MO = desc$sd[desc$group == "MO"],
      t = t_tbl$t,
      df = t_tbl$df,
      t_p = t_tbl$p_value,
      t_conf_low = t_tbl$conf_low,
      t_conf_high = t_tbl$conf_high,
      wilcox_W = w_tbl$W,
      wilcox_p = w_tbl$p_value
    )
  }
  
