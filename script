run_one_analysis <- function(analysis_mode) {
  
  cat("\n\n============================================================\n")
  cat("RUNNING ANALYSIS MODE:", analysis_mode, "\n")
  cat("============================================================\n")
  
  out_dir <- file.path(out_root, analysis_mode)
  dir.create(out_dir, showWarnings = FALSE, recursive = TRUE)
  
  qc_png_dir <- file.path(out_dir, "individual_QC_png")
  dir.create(qc_png_dir, showWarnings = FALSE, recursive = TRUE)
  
  # ------------------------------------------------------------
  # Select analysis data
  # ------------------------------------------------------------
  
  if (analysis_mode == "ip_vs_ol") {
    
    analysis_data <- long_all %>%
      dplyr::filter(
        viewing == "Binocular",
        condition %in% c("IP", "OL")
      ) %>%
      dplyr::mutate(
        group = condition,
        group_label = dplyr::case_when(
          condition == "IP" ~ "In-person",
          condition == "OL" ~ "Online",
          TRUE ~ condition
        ),
        # For IP vs OL, sub_id identifies the paired subject.
        subject_key = sub_id
      )
    
  } else if (analysis_mode == "bi_vs_mo_online") {
    
    analysis_data <- long_all %>%
      dplyr::filter(
        (viewing == "Binocular" & condition == "OL") |
          viewing == "Monocular"
      ) %>%
      dplyr::mutate(
        group = dplyr::case_when(
          viewing == "Binocular" & condition == "OL" ~ "BI",
          viewing == "Monocular" ~ "MO",
          TRUE ~ NA_character_
        ),
        group_label = dplyr::case_when(
          group == "BI" ~ "Binocular online",
          group == "MO" ~ "Monocular",
          TRUE ~ group
        ),
        # For BI vs MO, sub_id values overlap but are not the same people.
        # Therefore use a group-specific key.
        subject_key = paste(group, sub_id, participant_id, sep = "_")
      ) %>%
      dplyr::filter(!is.na(group))
    
  } else {
    stop("analysis_mode must be 'ip_vs_ol' or 'bi_vs_mo_online'.")
  }
  
  cat("\nSelected analysis mode:", analysis_mode, "\n")
  
  analysis_n <- analysis_data %>%
    dplyr::distinct(group, group_label, viewing, condition, sub_id, participant_id, subject_key) %>%
    dplyr::count(group, group_label)
  
  print(analysis_n)
  
  if (save_csv_outputs) {
    readr::write_csv(analysis_data, file.path(out_dir, paste0("analysis_data_", analysis_mode, ".csv")))
    readr::write_csv(analysis_n, file.path(out_dir, paste0("analysis_n_", analysis_mode, ".csv")))
  }
  
  # ------------------------------------------------------------
  # subject-level sigmoid fits
  # ------------------------------------------------------------
  
  fit_subject_side <- function(df, key) {
    
    side_label <- as.character(key$side[[1]])
    
    sfit <- fit_sigmoid_side(df, side_label = side_label)
    
    tibble::tibble(
      x0 = sfit$x0,
      k = sfit$k,
      rss = sfit$rss,
      x0_side_ok = sfit$x0_side_ok,
      k_direction_ok = sfit$k_direction_ok,
      x0_in_range = sfit$x0_in_range,
      fit_flag = sfit$fit_flag,
      tbw_raw = sfit$tbw_raw,
      pred_grid = list(sfit$pred_grid)
    )
  }
  
  subject_fits <- analysis_data %>%
    dplyr::filter(side %in% c("AV", "VA")) %>%
