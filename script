nice_tbl <- function(x, caption = NULL, digits = 3, align = "r") {
  if (inherits(x, "htest")) x <- broom::tidy(x)
  if (inherits(x, "effectsize_table") || inherits(x, "effectsize")) x <- as.data.frame(x)
  knitr::kable(x, caption = caption, digits = digits, align = align)
}

clean_chr <- function(x) {
  x <- as.character(x)
  x <- stringr::str_squish(x)
  x[x == ""] <- NA_character_
  x
}

to_num <- function(x) {
  suppressWarnings(as.numeric(as.character(x)))
}

standardise_condition <- function(x) {
  x_low <- stringr::str_to_lower(as.character(x))
  
  dplyr::case_when(
    stringr::str_detect(x_low, "inperson|in person|in-person") ~ "IP",
    stringr::str_detect(x_low, "online|on-line|on line")       ~ "OL",
    TRUE ~ NA_character_
  )
}

standardise_viewing <- function(x) {
  x_low <- stringr::str_to_lower(as.character(x))
  
  dplyr::case_when(
    stringr::str_detect(x_low, "monocular") ~ "Monocular",
    stringr::str_detect(x_low, "binocular") ~ "Binocular",
    TRUE ~ NA_character_
  )
}

extract_soa <- function(x) {
  as.numeric(stringr::str_extract(as.character(x), "-?\\d+"))
}

make_grid <- function(x, n = 600) {
  x <- x[is.finite(x)]
  if (length(unique(x)) < 2) return(numeric(0))
  seq(min(x), max(x), length.out = n)
}

valid_x0_range <- function(x0, soa_values) {
  soa_values <- soa_values[is.finite(soa_values)]
  if (!is.finite(x0)) return(FALSE)
  if (length(soa_values) < 2) return(FALSE)
  
  x0 >= min(soa_values, na.rm = TRUE) &&
    x0 <= max(soa_values, na.rm = TRUE)
}

# ============================================================
# sigmoid fitting and all that jazz
# ============================================================
# main TBW method:
# AV side: negative SOAs only
# VA side: positive SOAs only
#
# model:
# y = 1 / (1 + exp(-(SOA - x0) / k))
#
# TBW AV = abs(AV x0)
# TBW VA = abs(VA x0)
# Full TBW = TBW AV + TBW VA

# no capping!
# no automatic exclusion!!
# fits are flagged but retained!!! 
# full on EDI!!!!
# ============================================================

fit_sigmoid_side <- function(df_side, side_label) {
  
  df_nl <- df_side %>%
    dplyr::filter(is.finite(SOA), is.finite(prop)) %>%
    dplyr::arrange(SOA)
  
  base_pts <- tibble::tibble(SOA = sort(unique(df_side$SOA)))
  grid <- make_grid(df_side$SOA)
  
  fail <- list(
    x0 = NA_real_,
    k = NA_real_,
    rss = NA_real_,
    x0_side_ok = FALSE,
    k_direction_ok = FALSE,
    x0_in_range = FALSE,
    fit_flag = "fit_failed",
    tbw_raw = NA_real_,
    pred_pts = base_pts %>% dplyr::mutate(sig_fit = NA_real_),
    pred_grid = tibble::tibble(SOA = grid, sig_fit = NA_real_)
  )
  
  if (
    nrow(df_nl) < 3 ||
    length(unique(df_nl$SOA)) < 3 ||
    sd(df_nl$prop, na.rm = TRUE) < 1e-8
  ) {
    return(fail)
  }
  
  start_x0 <- median(df_nl$SOA, na.rm = TRUE)
  
  expected_k_start <- ifelse(side_label == "AV", 50, -50)
  opposite_k_start <- -expected_k_start
  
  try_fit <- function(k_start) {
    try(
      minpack.lm::nlsLM(
        prop ~ 1 / (1 + exp(-(SOA - x0) / k)),
        data = df_nl,
        start = list(x0 = start_x0, k = k_start),
        lower = c(x0 = -x0_abs_bound, k = -k_abs_bound),
        upper = c(x0 =  x0_abs_bound, k =  k_abs_bound),
        control = minpack.lm::nls.lm.control(
          maxiter = 1000,
          ftol = 1e-12,
          ptol = 1e-12
        )
      ),
      silent = TRUE
    )
  }
  
  fits <- list(
    expected = try_fit(expected_k_start),
    opposite = try_fit(opposite_k_start)
  )
  
  get_rss <- function(f) {
    if (inherits(f, "try-error")) return(Inf)
    sum(residuals(f)^2, na.rm = TRUE)
  }
  
  rss_vals <- purrr::map_dbl(fits, get_rss)
  
  if (!any(is.finite(rss_vals))) {
    return(fail)
  }
  
  fit <- fits[[which.min(rss_vals)]]
  rss_final <- min(rss_vals, na.rm = TRUE)
  
  co <- coef(fit)
  x0 <- unname(co[["x0"]])
  k  <- unname(co[["k"]])
  
  x0_side_ok <- dplyr::case_when(
    side_label == "AV" ~ is.finite(x0) && x0 < 0,
    side_label == "VA" ~ is.finite(x0) && x0 > 0,
    TRUE ~ FALSE
  )
  
  k_direction_ok <- dplyr::case_when(
    side_label == "AV" ~ is.finite(k) && k > 0,
    side_label == "VA" ~ is.finite(k) && k < 0,
    TRUE ~ FALSE
  )
  
  x0_in_range <- valid_x0_range(x0, df_nl$SOA)
  
  fit_flag <- dplyr::case_when(
    !isTRUE(x0_side_ok) ~ "wrong_side_x0",
    !isTRUE(k_direction_ok) ~ "wrong_curve_direction",
    !isTRUE(x0_in_range) ~ "x0_outside_tested_range",
    TRUE ~ "ok"
  )
  
  pred_pts <- base_pts %>%
    dplyr::mutate(sig_fit = 1 / (1 + exp(-(SOA - x0) / k)))
  
  pred_grid <- tibble::tibble(SOA = grid) %>%
    dplyr::mutate(sig_fit = 1 / (1 + exp(-(SOA - x0) / k)))
  
  list(
    x0 = x0,
    k = k,
    rss = rss_final,
    x0_side_ok = x0_side_ok,
    k_direction_ok = k_direction_ok,
    x0_in_range = x0_in_range,
    fit_flag = fit_flag,
    tbw_raw = abs(x0),
    pred_pts = pred_pts,
    pred_grid = pred_grid
  )
}

# ============================================================
# gaussian fitting
# ============================================================
# this is for QC / visual overlay and because I like gaussian 
#     better than two sigmoids! end of story! 
# ============================================================

fit_gaussian_full <- function(df_all) {
  
  df_nl <- df_all %>%
    dplyr::filter(is.finite(SOA), is.finite(prop)) %>%
    dplyr::arrange(SOA)
  
  base_pts <- tibble::tibble(SOA = sort(unique(df_all$SOA)))
  grid <- make_grid(df_all$SOA)
  
  fail <- list(
    fwhm = NA_real_,
    a = NA_real_,
    b = NA_real_,
    c = NA_real_,
    rss = NA_real_,
    fit_flag = "gaussian_fit_failed",
    pred_pts = base_pts %>% dplyr::mutate(gauss_fit = NA_real_),
    pred_grid = tibble::tibble(SOA = grid, gauss_fit = NA_real_)
  )
  
  if (
    nrow(df_nl) < 5 ||
    length(unique(df_nl$SOA)) < 5 ||
    sd(df_nl$prop, na.rm = TRUE) < 1e-8
  ) {
    return(fail)
  }
  
  start_a <- min(1, max(df_nl$prop, na.rm = TRUE))
  start_b <- 0
  start_c <- max(20, diff(range(df_nl$SOA, na.rm = TRUE)) / 5)
  
  fit <- try(
    minpack.lm::nlsLM(
      prop ~ a * exp(-((SOA - b)^2) / (2 * c^2)),
      data = df_nl,
      start = list(a = start_a, b = start_b, c = start_c),
      lower = c(a = 0, b = -x0_abs_bound, c = 1e-6),
      upper = c(a = 1.05, b = x0_abs_bound, c = x0_abs_bound),
      control = minpack.lm::nls.lm.control(
        maxiter = 1000,
        ftol = 1e-12,
        ptol = 1e-12
      )
    ),
    silent = TRUE
  )
  
  if (inherits(fit, "try-error")) {
    return(fail)
  }
  
  co <- coef(fit)
  
  a <- unname(co[["a"]])
  b <- unname(co[["b"]])
  c <- abs(unname(co[["c"]]))
  
  fwhm <- 2.355 * c
  
  pred_pts <- base_pts %>%
    dplyr::mutate(gauss_fit = a * exp(-((SOA - b)^2) / (2 * c^2)))
  
  pred_grid <- tibble::tibble(SOA = grid) %>%
    dplyr::mutate(gauss_fit = a * exp(-((SOA - b)^2) / (2 * c^2)))
  
  rss <- sum(residuals(fit)^2, na.rm = TRUE)
  
  list(
    fwhm = fwhm,
    a = a,
    b = b,
    c = c,
    rss = rss,
    fit_flag = "ok",
    pred_pts = pred_pts,
    pred_grid = pred_grid
  )
}

